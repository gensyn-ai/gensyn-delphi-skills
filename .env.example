# ── Network selection ─────────────────────────────────────────────────────────
# "testnet" (default), "mainnet", or "competition-testnet". Omit to use testnet.
# DELPHI_NETWORK=testnet

# ── API key (REQUIRED) ────────────────────────────────────────────────────────
DELPHI_API_ACCESS_KEY=

# ── Agent competition: evidence mining ────────────────────────────────────────
# See reference/competition.md. Runs on Mainnet: DELPHI_API_ACCESS_KEY must be a
# *Mainnet* key (https://api-access.delphi.fyi/). No signer is needed to submit
# evidence or send feedback.
# The wallet the API key was created with (also your DoraHacks registration wallet):
# DELPHI_WALLET_ADDRESS=0x...
# Shown with your results, one set per agent:
# DELPHI_AGENT_ID=my-agent
# DELPHI_AGENT_HARNESS=claude-code
# DELPHI_AGENT_MODEL=
# DELPHI_FEEDBACK_URL=https://feedback.delphi.fyi
# Where `npm run evidence` sends its calls, and the log it writes for each submission:
# DELPHI_EVIDENCE_URL=https://delphi.fyi/v1
# DELPHI_EVIDENCE_LOG=evidence-log.jsonl

# ── First competition (trading, ended) ────────────────────────────────────────
# Only for DELPHI_NETWORK=competition-testnet. See reference/competition-trading.md.
# Needs a *testnet* API key.
# DELPHI_COMPETITION_ID=

# ── Signer type: "private_key" or "cdp_server_wallet" (default) ──────────────
# DELPHI_SIGNER_TYPE=cdp_server_wallet

# ── Option A: Private key signer ──────────────────────────────────────────────
# Set DELPHI_SIGNER_TYPE=private_key and provide:
# WALLET_PRIVATE_KEY=0x...

# ── Option B: CDP Server Wallet signer (default) ──────────────────────────────
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_WALLET_ADDRESS=0x...

# ── Optional overrides (set by DELPHI_NETWORK defaults if omitted) ────────────
# GENSYN_RPC_URL=https://gensyn-testnet.g.alchemy.com/public
# GENSYN_CHAIN_ID=685685
# Pins all calls to one gateway and disables per-market routing. Leave unset
# unless you are pointing at a local/custom deployment — a real mainline
# gateway address here will revert calls for markets it does not own.
# DELPHI_GATEWAY_CONTRACT=0x...
# DELPHI_API_BASE_URL=https://delphi-agentic-trading-api.gensyn-staging.ai/
# Sepolia RPC for scripts/bridge-eth-to-gensyn-testnet.ts (PublicNode default)
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ── Cloudflare Access (if the API is behind CF Access) ───────────────────────
# CF_ACCESS_ID=
# CF_ACCESS_SECRET=
# A user token for `npm run evidence` (cloudflared access token -app=<url>):
# CF_ACCESS_TOKEN=
