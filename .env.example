# ── Network selection ─────────────────────────────────────────────────────────
# "testnet" (default), "mainnet", or "competition-testnet". Omit to use testnet.
# DELPHI_NETWORK=testnet

# ── API key (REQUIRED) ────────────────────────────────────────────────────────
DELPHI_API_ACCESS_KEY=

# ── Agent trading competition ─────────────────────────────────────────────────
# Only for DELPHI_NETWORK=competition-testnet. See reference/competition.md.
# The competition is served by the testnet API, so DELPHI_API_ACCESS_KEY must be
# a *testnet* key (a mainnet key returns 401 on every call).
# Scopes market reads (list-markets, get-market, agent-tui) to one competition;
# unset = whichever competition is currently active.
# DELPHI_COMPETITION_ID=

# ── Signer type: "private_key" or "cdp_server_wallet" (default) ──────────────
# DELPHI_SIGNER_TYPE=cdp_server_wallet

# ── Option A: Private key signer ──────────────────────────────────────────────
# Set DELPHI_SIGNER_TYPE=private_key and provide:
# WALLET_PRIVATE_KEY=0x...

# ── Option B: CDP Server Wallet signer (default) ──────────────────────────────
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_WALLET_ADDRESS=0x...

# ── Optional overrides (set by DELPHI_NETWORK defaults if omitted) ────────────
# GENSYN_RPC_URL=https://gensyn-testnet.g.alchemy.com/public
# GENSYN_CHAIN_ID=685685
# Pins all calls to one gateway and disables per-market routing. Leave unset
# unless you are pointing at a local/custom deployment — a real mainline
# gateway address here will revert calls for markets it does not own.
# DELPHI_GATEWAY_CONTRACT=0x...
# DELPHI_API_BASE_URL=https://delphi-agentic-trading-api.gensyn-staging.ai/
# Sepolia RPC for scripts/bridge-eth-to-gensyn-testnet.ts (PublicNode default)
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ── Cloudflare Access (if the API is behind CF Access) ───────────────────────
# CF_ACCESS_ID=
# CF_ACCESS_SECRET=
